# ─── Situs ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Email akun SUPERADMIN pertama yang dibuat seed (idempoten).
SEED_SUPERADMIN_EMAIL=admin@reditech.id
# Kata sandi akun seed. Kosong = `Reditech#2026` saat pengembangan dan tanpa
# kata sandi sama sekali saat produksi (pemilik masuk lewat Google OAuth).
# Diisi eksplisit = dipasang ulang setiap seed dijalankan.
SEED_ADMIN_PASSWORD=

# ─── Database & cache ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://reditech:reditech@localhost:5432/reditech?schema=public
REDIS_URL=redis://localhost:6379

# ─── Auth.js ──────────────────────────────────────────────────────────────
# 32 byte acak base64: `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Kunci AES-256-GCM untuk rahasia TOTP admin (32 byte base64 atau hex):
# `openssl rand -base64 32`. Kosong = diturunkan dari AUTH_SECRET.
MFA_ENCRYPTION_KEY=

# ─── DOKU ─────────────────────────────────────────────────────────────────
DOKU_CLIENT_ID=
DOKU_SECRET=
DOKU_IS_PRODUCTION=false

# ─── Google Drive (berkas item, hanya diakses server) ─────────────────────
# Service account JSON yang di-encode base64 satu baris.
GOOGLE_DRIVE_SA_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Penyimpanan berkas: `drive` (produksi) atau `local` (pengembangan).
# Kosong = Drive bila kredensial di atas lengkap, selain itu `local`.
STORAGE_DRIVER=
# Akar penyimpanan lokal; hanya dipakai saat STORAGE_DRIVER=local.
LOCAL_STORAGE_DIR=.storage
# Rahasia HMAC cookie gerbang unduhan. Kosong = memakai AUTH_SECRET.
DL_GATE_SECRET=

# ─── Cloudflare R2 (gambar) ───────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET=
R2_BUCKET=
R2_PUBLIC_URL=
