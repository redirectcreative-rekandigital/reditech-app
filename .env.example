# ─── Situs ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Email akun SUPERADMIN pertama yang dibuat seed (idempoten).
SEED_SUPERADMIN_EMAIL=admin@reditech.id

# ─── Database & cache ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://reditech:reditech@localhost:5432/reditech?schema=public
REDIS_URL=redis://localhost:6379

# ─── Auth.js ──────────────────────────────────────────────────────────────
# 32 byte acak base64: `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── DOKU ─────────────────────────────────────────────────────────────────
DOKU_CLIENT_ID=
DOKU_SECRET=
DOKU_IS_PRODUCTION=false

# ─── Google Drive (berkas item, hanya diakses server) ─────────────────────
# Service account JSON yang di-encode base64 satu baris.
GOOGLE_DRIVE_SA_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ─── Cloudflare R2 (gambar) ───────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET=
R2_BUCKET=
R2_PUBLIC_URL=
