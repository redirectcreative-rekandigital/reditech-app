# Lingkungan pengembangan saja. Build produksi memakai Dockerfile multi-stage
# yang ditulis di M7 (hardening), bukan file ini.
FROM node:22-alpine

WORKDIR /app

RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000

ENV NEXT_TELEMETRY_DISABLED=1
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
